# Logger
LOG_DIR=./logs
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true

DB_TYPE=sqlite
# SQLite 数据库文件路径（仅 DB_TYPE=sqlite 时生效）
DB_PATH=./data/app.db
# PostgreSQL 连接字符串（仅 DB_TYPE=postgres 时生效）
# DATABASE_URL=postgresql://user:password@localhost:5432/cooking_app

# ── 服务端配置 ──
SERVER_HOST=localhost
SERVER_PORT=3000
CLIENT_ORIGIN=*
NODE_ENV=development

# ── 前端配置 ──
CLIENT_DEV_PORT=8080
CLIENT_BASE_PATH=/

# ── 日志配置 ──
LOG_DIR=logs